{
  "name": "space-findx",
  "version": "1.0.0",
  "description": "> Pipeline astrométrico de alta precisão para detecção de **Objetos Próximos da Terra (NEOs)** e transientes astronômicos em imagens CCD.",
  "main": "app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "backend": "uvicorn server:app --reload",
    "start": "concurrently \"npm run backend\" \"npm run dev\" \"npm run tunnel\"",
    "start:local": "concurrently \"npm run backend\" \"npm run dev\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albert-wb/space-findx.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/albert-wb/space-findx/issues"
  },
  "homepage": "https://github.com/albert-wb/space-findx#readme",
  "devDependencies": {
    "cloudflared": "^0.7.1",
    "concurrently": "^10.0.3",
    "vite": "^8.0.16"
  }
}
